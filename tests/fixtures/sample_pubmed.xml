      <Article>
        <ArticleTitle>Dapagliflozin and outcomes in heart failure with reduced ejection fraction: a randomized trial</ArticleTitle>
        <Journal>
          <Title>New England Journal of Medicine</Title>
          <JournalIssue>
            <PubDate>
              <Year>2019</Year>
            </PubDate>
          </JournalIssue>
        </Journal>
        <Abstract>
          <AbstractText Label="BACKGROUND">Sodium-glucose cotransporter 2 inhibitors reduce the risk of cardiovascular death in patients with type 2 diabetes.</AbstractText>
          <AbstractText Label="METHODS">We randomly assigned 4744 patients with heart failure and reduced ejection fraction to receive dapagliflozin or placebo.</AbstractText>
          <AbstractText Label="RESULTS">Hospitalization for heart failure or cardiovascular death occurred in 16.3% of the dapagliflozin group versus 21.2% of the placebo group.</AbstractText>
          <AbstractText Label="CONCLUSIONS">Dapagliflozin reduced the risk of worsening heart failure or death from cardiovascular causes.</AbstractText>
        </Abstract>
        <PublicationTypeList>
          <PublicationType>Randomized Controlled Trial</PublicationType>
          <PublicationType>Journal Article</PublicationType>
        </PublicationTypeList>
      </Article>
